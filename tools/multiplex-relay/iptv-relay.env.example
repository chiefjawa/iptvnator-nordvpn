# Copied to ~/.config/iptv-relay/iptv-relay.env by systemd/install.sh.
# Not secret: it only names where the private relay config lives.
MULTIPLEX_RELAY_CONFIG=/home/jackd/Work/iptvnator-private/multiplex-relay.private.json
# NordVPN region or server for the relay namespace. Empty: the desktop
# app's choice (its linux-vpn.json), moved to another server of the same
# country if that server is already in use by another namespace.
RELAY_VPN_SERVER=
# The desktop app's VPN settings (server choice only; no credentials).
IPTVNATOR_VPN_SETTINGS=/home/jackd/Work/iptvnator-private/profile/user-data/linux-vpn.json
